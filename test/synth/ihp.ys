# The whole chip mapped to IHP SG13CMOS5L standard cells at the slow corner (1.08 V, 125 C), with ABC told
# to aim for the 16.6 ns clock. The SRAM macros stay black boxes. This is not LibreLane's flow: there is no
# placement, no wires and no clock tree, so the numbers are logic only.
# Run from test/synth (make -C test/synth), after the liberty file is fetched into build/.

read_liberty -lib build/sg13cmos5l_stdcell_slow_1p08V_125C.lib
read_verilog -DSYNTHESIS ../../src/project.v ../../src/protoemu_core.v ../../src/protoemu_fifo.v ../../src/protoemu_table.v ../../src/protoemu_trace.v
read_verilog -lib -DFUNCTIONAL ../ihp_sram/RM_IHPSG13_1P_512x32_c2_bm_bist.v
hierarchy -check -top tt_um_mikekovetsky_protoemu
synth -top tt_um_mikekovetsky_protoemu -flatten
dfflibmap -liberty build/sg13cmos5l_stdcell_slow_1p08V_125C.lib
abc -liberty build/sg13cmos5l_stdcell_slow_1p08V_125C.lib -D 16600
hilomap -hicell sg13cmos5l_tiehi L_HI -locell sg13cmos5l_tielo L_LO
opt_clean -purge
tee -o build/ihp_stat.txt stat -liberty build/sg13cmos5l_stdcell_slow_1p08V_125C.lib
write_json build/ihp_netlist.json
# A gate-level netlist for test/Makefile's GATES=yes run, before layout (see test/README.md).
write_verilog -noattr -noexpr build/ihp_netlist.v
