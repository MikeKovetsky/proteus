# Four protocols at once, not a bake-off scenario: it backs the claim of four engines.
# The four machines take turns, so each steps every fourth clock and counts time in turns of 4 clocks.
#   uart tx   channel 0 -> P0, 115200 baud        uart rx   P1 -> channel 1, 115200 baud
#   spi ctrl  channel 3 -> P2 P3 P4, mode 0        ps/2 rx   P5 P6 -> channel 2

const BIT = 130                      # 520 clocks: 115200 baud within 0.2%

machine uart_tx
    out   TX=P0
    order lsb
idle:   TX=1, wait rx0
        S=pop0, K=8
        TX=0, hold BIT
bit:    TX=d, shift, K-=1, hold BIT => kz: stop | bit
stop:   TX=1, hold BIT => idle

machine uart_rx
    in    RX=P1
    order lsb
idle:   wait !RX
        K=8
        hold BIT + BIT/2 - 2
bit:    shift RX, K-=1
        => kz: stop
        hold BIT - 2 => bit
stop:   hold BIT - 1 => RX: good
        wait RX => idle              # a 0 stop bit: dropped. Channel 2 is PS/2's, so nothing can report it
good:   push1=S => idle

machine spi                          # channel 3 gives [n][n bytes]; write only, 1.25 MHz
    out   SCK=P2, MOSI=P3, CS=P4
    order msb
idle:   SCK=0, CS=1, wait rx3
        N=pop3
next:   => nz: done
        wait rx3
        S=pop3, K=8, N-=1, CS=0
bit:    SCK=0, MOSI=d, hold 6
        SCK=1, shift, K-=1, hold 6 => kz: next | bit
done:   SCK=0, hold 6
        CS=1, hold 6 => idle

machine ps2                          # good bytes to channel 2
    in    CLK=P5, DATA=P6
    order lsb
    crc   poly=1 match=1
idle:   wait !CLK
        K=8, crc=0
        wait CLK
bit:    wait !CLK
        shift DATA, crc+=DATA, K-=1
        wait CLK => kz: parity | bit
parity: wait !CLK
        crc+=DATA
        wait CLK
        wait !CLK
        wait CLK
        => crc: good | idle
good:   push2=S => idle
