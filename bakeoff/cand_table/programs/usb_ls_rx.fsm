# Low-speed USB receiver (1.5 Mbit/s, 40 clocks per bit). Every byte after SYNC goes to channel 1.
# At the end of a packet channel 2 gets [0x00 good or 0x01 bad][byte count]. Valid handshake PIDs
# (ACK/NAK/STALL/NYET, matched in 1 clock by v2 TCAM) are accepted with 1 byte and no CRC; data packets
# require a valid CRC-16. Seven 1s in a row are bad and end the pushes. Six right before EOP are accepted,
# as the harness's decoder does. One extra bit before EOP, which a hub may add, is let through.
#
# The bit clock comes from the edges of D+. An edge starts a bit cell and restarts the timer, so the
# receiver follows the sender. A cell that starts with an edge is a 0; a cell with no edge is a 1.
# After an edge the line is looked at 16 clocks on, when an SE0 of up to 210 ns inside the transition is
# over, and otherwise in the middle of the cell. Both lines low (SE0) there ends the packet. The work of
# a bit must end before the next edge, which that SE0 and jitter can bring to 22 clocks after the last.

tcam 0xD2/0xFF -> 1   # ACK
tcam 0x5A/0xFF -> 1   # NAK
tcam 0x1E/0xFF -> 1   # STALL
tcam 0x96/0xFF -> 1   # NYET

machine usb
    in    DP=P0, DM=P1
    order lsb
    crc   poly=0xA001 init=0xFFFF match=0xB001   # CRC-16 over data and CRC leaves 0xB001
    const BIT  = 40
    const HALF = 17                  # in SYNC: edge seen -> middle of that cell, less three
    const LOOK = 13                  # edge seen -> the look for SE0, less three
    const NEXT = 41                  # from that look -> middle of the next cell
    const FULL = 37                  # middle of a cell -> middle of the next, less three

# What follows an edge (zero) and a cell with none (one). ZERO and ONE are what a 0 and a 1 do to the data
# path. CELL waits for the next cell, and END runs when a byte's eighth bit is in. J counts 1s: after six,
# the next 0 was stuffed by the sender and is dropped, and a 1 is an error.
macro zero(ZERO, END, CELL)
        T=LOOK                       # an edge
        wait tz
        => !DP & !DM: eop
        T=NEXT => jz: drop
        ZERO, K-=1, J=6 => kz: END | CELL    # K is loaded with 7: kz is true at the eighth bit
drop:   J=6 => CELL
end
macro one(ONE, END, CELL)
        T=FULL+1 => !DP & !DM: eop   # the timer ran out first: no edge, and this is mid-cell
        ONE, K-=1, J-=1 => jz: broken | kz: END | CELL    # broken: a seventh 1
end

start:  R=1, K=7                     # R is the verdict: bad until shown good
        J=5, crc=init, N=0           # the 1 that ends SYNC counts towards the next stuffed bit
idle:   wait DP                      # J to K: D+ rises and SYNC begins
sync0:  T=HALF
        wait tz
        T=FULL+1
        wait => edge: sync0 | tz: sync1
sync1:  T=FULL+1                     # a cell with no edge is the 1 that ends SYNC
plain:  wait => edge: plain0 | tz: plain1    # the PID, which is not part of the CRC
plain0: use zero(shift 0, pid, plain)
plain1: use one(shift 1, pid, plain)
pid:    push1=S, N+=1, K=7
        dispatch tcam4 => data | 1: whole    # valid handshake PID: good if EOP follows directly
data:   wait => edge: data0 | tz: data1
data0:  use zero({shift 0, crc+=0}, byte, data)
data1:  use one({shift 1, crc+=1}, byte, data)
byte:   push1=S, N+=1, K=7           # the next line watches for an edge too, as T cannot have run out yet
        R=1 => crc & edge: whole0 | crc: whole | edge: data0 | data
whole:  R=0 => edge: data0 | tz: data1 | whole    # good if the packet ends here. It watches like data
whole0: R=0 => data0

# At EOP K is 7 after a whole byte, and 6 with one bit more, which may be a hub's.
eop:    J=5
shrink: K-=1, J-=1 => kz: short | jz: verdict | shrink
verdict: push2=R => count
short:  push2=1 => count

# A stuffing error. The packet is over at its EOP, or when the bus has been J for 16 bits.
broken: T=16*BIT
inj:    wait => !DM: notj | tz: short
notj:   => DP: broken                # K
        hold 15                      # an SE0 inside a transition lasts up to 210 ns
        => !DP & !DM: short | broken

count:  push2=Nlo
        wait DM => start             # back to J
