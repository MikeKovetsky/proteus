# SPI controller, mode 2 (CPOL 1, CPHA 0), 5 MHz (12 clocks per bit), MSB first.
# The clock idles high. Data changes on the rising edge and is sampled on the falling edge.
# Channel 0 gives [n][n bytes]. The n bytes read from MISO go to channel 1. A host that falls behind stops the
# clock between two bytes, with CS low, until its next byte is there.

machine spi
    out   SCK=P0, MOSI=P1, CS=P3
    in    MISO=P2
    order msb

idle:   SCK=1, CS=1, wait rx0
        N=pop0                       # bytes to transfer
        => nz: idle
        wait rx0
        S=pop0, K=7, N-=1, CS=0      # select the target, first byte in the shifter
        hold 3                       # the first edge samples: its bit goes out before it

# One bit is exactly 12 clocks, also across a byte boundary. A read sees the pins of 2 clocks before, and a
# write reaches them a clock later: the edge made on clock 6 is on the pin in 7, and clock 9 reads MISO as of 7.
bit:    SCK=1, MOSI=d, hold 6        # clocks 0-5: rising edge, data out
        SCK=0, hold 3                # clocks 6-8: falling edge
        shift MISO, K-=1 => kz: byte # clock 9: MISO at that edge. The rule sees K as it was: 7 down to 0
        hold 2 => bit                # clocks 10-11
byte:   push1=S => nz: last | rx0: load # clock 10: the byte read, and is the next one here?
        wait rx0                     # it is not: the clock stops
load:   S=pop0, K=7, N-=1 => bit     # clock 11: the next byte to send
last:   nop                          # clock 11
        SCK=1, hold 6                # the last bit ends and the clock rests
        CS=1, hold 12 => idle
