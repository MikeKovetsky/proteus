# I2C controller, fast mode (400 kHz), open drain: a pin is pulled low (=0) or released (=z), never driven high.
# Channel 0 gives [addr7][nw][nw bytes][nr], and the chip does:
#   nw > 0, nr > 0    START, address+W, the bytes, repeated START, address+R, nr bytes, STOP
#   nw > 0, nr = 0    START, address+W, the bytes, STOP
#   nw = 0, nr > 0    START, address+W, repeated START, address+R, nr bytes, STOP
#   nw = 0, nr = 0    START, address+W, STOP: is anybody there?
# The bytes read go to channel 1, then one status byte to channel 2: 0x00 done, 0x01 NACK, 0x02 the bus is
# stuck (SCL held low for 25 ms, or SDA low where it must be high). After 0x01 and 0x02 the rest of the
# request is dropped, and after 0x02 both lines are left released.

machine i2c
    out   SCL=P0, SDA=P1
    in    SCLI=P0, SDAI=P1
    order msb
    crc   init=0x3FFFFF match=0      # the time-out: 23 rounds of T, 25.1 ms
    const LOW  = 80              # SCL is low for LOW + 3 clocks
    const HIGH = 63              # and high for HIGH + 4, once seen high: 150 clocks a bit

# One SCL pulse, entered with SCL low. SET is what SDA does 0.42 us or more into the low time: past any
# hold time, and early enough to be valid within fast mode's 0.9 us after a 300 ns rise.
# The caller pulls SCL low again, and may look at SDA in that same clock.
macro pulse(SET)
        hold 25
        SET, call clock              # the rest of the pulse is the subroutine at the end of this file
end

# Send the byte in S (K=8) and take the ACK bit. Leaves SCL low.
macro send(NACK)
wbit:   use pulse(SDA=od)            # data bit: release for 1, pull low for 0
        SCL=0, shift, K-=1
        => kz: ack | wbit
ack:    use pulse(SDA=z)             # the target answers
        SCL=0 => SDAI: NACK          # SDA still high: nobody acknowledged
end

idle:   wait rx0
        R=pop0                       # the address is needed twice
        wait rx0
        N=pop0, J=1                  # bytes to write. J=1: the read count is still in the queue
        call clock                   # SCL must be high, or become so
        => !SDAI: stuck
        SDA=0, hold HIGH             # START: SDA falls while SCL is high
        SCL=0
        S=R
        shift 0, K=8                 # address, then 0 for write
        use send(nack)
write:  => nz: wrote
        wait rx0
        S=pop0, K=8, N-=1
        use send(nack)
        goto write
wrote:  wait rx0
        N=pop0, J=0                  # bytes to read
        => nz: done                  # none: no repeated START

        use pulse(SDA=z)             # SDA high, then SCL high
        SDA=0, hold HIGH             # repeated START
        SCL=0
        S=R
        shift 1, K=8                 # address, then 1 for read
        use send(nack)
read:   K=8
rbit:   use pulse(SDA=z)             # the target drives SDA
        SCL=0, shift SDAI, K-=1      # this clock still sees SDA as it was while SCL was high
        => kz: got | rbit
got:    push1=S, N-=1
        => nz: final
        use pulse(SDA=0)             # ACK: more bytes wanted
        SCL=0 => read
final:  use pulse(SDA=z)             # NACK: that was the last byte
        SCL=0

done:   R=0 => stop                  # from here on R is the status
nack:   R=1
stop:   use pulse(SDA=0)             # SDA low, then SCL high
        SDA=z, hold LOW              # STOP: SDA rises while SCL is high
        => SDAI: drain
stuck:  R=2, SCL=z, SDA=z            # also where the time-out below ends up, from any pulse
drain:  => jz: report                # J=0: the whole request has been taken
left:   => nz: tail                  # N bytes of the write part are still queued
        wait rx0
        pop0, N-=1 => left
tail:   wait rx0
        pop0                         # the read count
report: push2=R => idle

# The shared second half of every pulse. It waits for SCL to rise, so a target that stretches the clock
# is waited for, and gives up after 25 ms: a timer of 65,535 clocks, times the zeros it takes to clear the LFSR.
clock:  hold LOW - 25
        SCL=z, crc=init, T=65535
cwait:  wait => SCLI: high | tz: tick
tick:   crc>>=1, T=65535 => crc: stuck | cwait
high:   hold HIGH - 1
        ret
